# Supabase — valores públicos do projeto (visíveis no dashboard Supabase)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Mapbox — token público (pk.*), visível no client bundle por design
VITE_MAPBOX_ACCESS_TOKEN="pk.eyJ1IjoiLi4uIn0...."
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
VITE_MAPBOX_INITIAL_CENTER=
VITE_MAPBOX_INITIAL_ZOOM=12
VITE_MAPBOX_CENTER=
VITE_MAPBOX_ZOOM=12

# Render — API key PRIVADA, nunca commitar o valor real
# Gerar em: https://dashboard.render.com/u/settings
RENDER_API_KEY="rnd_..."
